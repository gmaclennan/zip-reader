{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "noEmit": true,
    "rootDir": ".",
    // rootDir "." stops TypeScript mapping the dist/ targets of package imports back to src/
    "paths": {
      "#crc32": ["./src/crc-node.ts"]
    }
  },
  "include": ["vitest.config.ts", "test/**/*.ts"]
}
